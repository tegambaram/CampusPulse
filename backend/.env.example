# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# MongoDB Atlas connection string (Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campuspulse?retryWrites=true&w=majority

# Any long random string, used to sign login tokens (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-string

# Port the server listens on (Render/Railway set this for you automatically in production)
PORT=4000

# Comma-separated list of origins allowed to call this API (leave as * while developing)
CORS_ORIGIN=*

# Only set this locally if your ISP/router DNS blocks Atlas SRV lookups
# (symptom: "querySrv ENOTFOUND" errors on mongoose.connect). Leave unset
# in production (Render etc.) so it uses the host's normal DNS.
# FORCE_DNS_SERVER=8.8.8.8
